# Copy this file to .env.local (git-ignored) and fill in the values.
# Only EXPO_PUBLIC_* variables are allowed here: they are bundled into the app and
# visible to anyone. Never put a Supabase secret / service-role key in this file.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key: Project Settings > API Keys
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
